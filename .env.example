PORT=8010
BASE_URL=http://localhost:8010
SESSION_SECRET=replace_with_at_least_32_random_characters
SUBSCRIPTION_PRICE_RUB=10
SUBSCRIPTION_PRICE_USD=5

# demo — деньги не списываются; cloudpayments — международные карты и подписка.
PAYMENT_MODE=demo
CLOUDPAYMENTS_PUBLIC_ID=
CLOUDPAYMENTS_API_SECRET=
LAVA_API_KEY=
LAVA_WEBHOOK_SECRET=
LAVA_PRODUCT_ID=65d07a9a-1773-465f-bc2e-d295dabc1f1b
LAVA_OFFER_ID=485be0d8-b7c2-4abe-9bf3-86674d47905f
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
BILLING_INTERVAL_MINUTES=15

# Купоны доступны только после регистрации площадки и подключения программ.
# Можно указать готовый access token либо client ID + secret для его автообновления.
ADMITAD_ACCESS_TOKEN=
ADMITAD_CLIENT_ID=
ADMITAD_CLIENT_SECRET=
ADMITAD_WEBSITE_ID=
ADMITAD_REGION=US

# Автообновление запускается внутри сервера. Минимальный интервал — 15 минут.
AUTO_JOBS=true
PROMO_SYNC_MINUTES=60

# Дополнительные разрешённые HTTPS-ленты. Каждая должна отдавать массив или
# {"promos": [...]} с полями merchant, title, code, category, validUntil, url.
# tokenEnv — имя переменной окружения с Bearer-токеном конкретной ленты.
PARTNER_FEEDS_JSON=[]
# EXAMPLE_PARTNER_TOKEN=
