PORT=8010
BASE_URL=http://localhost:8010
SESSION_SECRET=replace_with_at_least_32_random_characters
SUBSCRIPTION_PRICE_RUB=10

# demo — деньги не списываются; yookassa — настоящая оплата.
PAYMENT_MODE=demo
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
BILLING_INTERVAL_MINUTES=15

# Купоны доступны только после регистрации площадки и подключения программ.
ADMITAD_ACCESS_TOKEN=
ADMITAD_WEBSITE_ID=

# Автообновление запускается внутри сервера. Минимальный интервал — 15 минут.
AUTO_JOBS=true
PROMO_SYNC_MINUTES=60

# Дополнительные разрешённые HTTPS-ленты. Каждая должна отдавать массив или
# {"promos": [...]} с полями merchant, title, code, category, validUntil, url.
# tokenEnv — имя переменной окружения с Bearer-токеном конкретной ленты.
PARTNER_FEEDS_JSON=[]
# EXAMPLE_PARTNER_TOKEN=
